FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive

# Core CLI Utilities & Security Packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    python3-venv \
    nmap \
    masscan \
    sqlmap \
    ffuf \
    nikto \
    radare2 \
    gdb \
    binwalk \
    checksec \
    whois \
    dnsutils \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Golang High-Speed Tooling Suite
COPY --from=golang:1.23-alpine /usr/local/go/ /usr/local/go/
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"

RUN go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest && \
    go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest && \
    go install -v github.com/projectdiscovery/naabu/v2/cmd/naabu@latest && \
    go install -v github.com/projectdiscovery/katana/cmd/katana@latest && \
    go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest

# Prepare Wordlists
RUN mkdir -p /opt/seclists && \
    curl -sSL https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/raft-medium-directories.txt -o /opt/seclists/raft-medium-dirs.txt && \
    curl -sSL https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/common.txt -o /opt/seclists/common.txt

WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
