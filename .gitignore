# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Node & TypeScript
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Go Binaries & Cache
bin/*.exe
bin/scanner
*.out

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# IDE & Editor Specific
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Storage & Session Data
storage/sessions/*
!storage/sessions/.gitkeep
storage/targets/*
!storage/targets/.gitkeep
*.log

# Large Cloned Reference Repositories (Sync via scripts/sync_references.py)
references/
